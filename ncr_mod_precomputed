struct Combinatorics {
    int n;
    ll mod;
    vector<ll> fact, invFact;

    static ll power(ll b, ll e, ll m) {
        ll r = 1; b %= m;
        for (; e > 0; e >>= 1, b = b * b % m)
            if (e & 1) r = r * b % m;
        return r;
    }

    // Precomputes everything in O(n). mod must be prime and > n.
    Combinatorics(int n, ll mod = 1000000007) : n(n), mod(mod), fact(n + 1), invFact(n + 1) 
    {
        fact[0] = 1;
        for(int i = 1; i <= n; ++i) 
            fact[i] = fact[i - 1] * i % mod;

        invFact[n] = power(fact[n], mod - 2, mod);   // Fermat's little theorem
        for(int i = n; i > 0; --i) 
            invFact[i - 1] = invFact[i] * i % mod;
    }

    // nCr % mod in O(1)
    ll C(int a, int b) 
    {
        if(b < 0 || b > a || a > n) 
            return 0;

        return fact[a] * invFact[b] % mod * invFact[a - b] % mod;
    }

    // nPr % mod in O(1)
    ll P(int a, int b) 
    {
        if(b < 0 || b > a || a > n) 
            return 0;
        return fact[a] * invFact[a - b] % mod;
    }
};
