void compute(int lps[], string& s)
{
    int m = s.size();
    lps[0] = 0;
    int suf = 1;
    int pre = 0;

    while(suf < m)
    {
        if(s[pre] == s[suf])
        {
            lps[suf] = pre + 1;
            pre++;
            suf++;
        }
        else
        {
            if(pre != 0)
            {
                pre = lps[pre - 1];
            }
            else
            {
                lps[suf] = 0;
                suf++;
            }
        }
    }
}

